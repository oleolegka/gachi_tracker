<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Every permission below exists for the workout timer, and each is listed with the
        one thing it buys. The phone this app is built for runs GrapheneOS, where the
        permission list is read, so nothing is requested "just in case".

        There is deliberately no INTERNET, no ACCESS_NETWORK_STATE, no
        RECEIVE_BOOT_COMPLETED and no REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. The app never
        talks to a network; a timer is not resumed across a reboot (the monotonic clock it
        counts on does not survive one, and a rest between sets outlives no restart); and
        asking to be exempted from battery management is a request the user can make
        themselves if they ever want it.
    -->

    <!--
        Shows the countdown and its buttons. Android 13+ only; asked for at the moment the
        timer is switched on, never at first launch. Refusing it does not break the timer:
        the countdown still runs and still signals, it just has no notification.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Keeps the process from being frozen while a run OR a rest between sets is live.
        Without a foreground service Android suspends the app within about twenty seconds of
        the screen turning off, which is the whole failure this feature exists to avoid. One
        service covers both; see TimerService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        The service type. A workout timer matches none of the platform's named categories,
        and the one that looks closest, shortService, is capped at three minutes and cannot
        be extended - shorter than an ordinary rest between heavy sets. See TimerService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        The primary signal. The phone is in a pocket and the ringer is usually on silent,
        so the buzz at a step boundary is what is actually noticed, not the tone.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Keeps the CPU from suspending between step boundaries. A foreground service stops
        the process being killed; it does not stop the device sleeping, and a Tabata
        interval is ten seconds long. Held only while the clock is moving, released on
        pause and stop, and always taken with a timeout.

        Taken for the PROTOCOL RUN only, never for the rests between sets: a rest is minutes
        long and says "not before", its wake-up alarm wakes the device by itself, and a lock
        per rest would be a lock held for most of a ninety-minute session. See
        FloorController.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        The backstop alarm at the end of a step, so the signal still fires if the process
        is killed despite the service.

        Two permissions because the platform changed its mind: up to Android 12L the
        needed one is SCHEDULE_EXACT_ALARM, hence the maxSdkVersion; from Android 13
        USE_EXACT_ALARM is the one for apps whose core function IS a timer or an alarm
        clock, and unlike SCHEDULE_EXACT_ALARM it is granted at install instead of sending
        the user into a settings screen. This app is a timer, so the second one is the
        honest fit. If either is somehow absent the code falls back to an inexact alarm
        rather than failing.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
        Package visibility, not a permission: since Android 11 an app cannot even SEE
        whether a speech engine is installed without declaring this. It is what lets the
        settings screen say "no speech engine found" truthfully on a phone without Google
        services instead of claiming that on every phone.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
        The launcher icon is an adaptive icon and nothing else: no density-specific PNGs.
        minSdk is 29, every device that can install this app understands
        mipmap-anydpi-v26, and a vector drawing needs no rasterising by hand. The
        drawing, its framing against the launcher mask and the recipe for
        regenerating it all live in res/drawable/ic_launcher_foreground.xml.
    -->
    <!--
        enableOnBackInvokedCallback: the modern back contract, where the app declares what
        back will do BEFORE the gesture finishes, so the system can show the app sliding
        away under the thumb and the user can abandon the swipe. Redundant on this phone
        (targetSdk 35 and above opts in anyway) and stated all the same, because it is the
        only place a reader would look for the answer, and because dropping targetSdk would
        otherwise silently turn the behaviour off.

        Back itself is decided in one place, ui/Navigation.kt, and installed by a single
        androidx BackHandler in GachiApp. Nothing here changes if the flag is ignored: the
        handler still runs, it just does not animate.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="gachimuchi"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gachimuchi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="gachimuchi"
            android:theme="@style/Theme.Gachimuchi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Counts down the intervals of a workout, and the rest between sets, while the phone is in a pocket with the screen off." />
        </service>

        <!--
            Receives the backstop alarm and the notification buttons. Not exported and
            every intent naming it is explicit, so only this app can drive the timer.
        -->
        <receiver
            android:name=".timer.TimerReceiver"
            android:exported="false" />

        <!--
            Lets another app read ONE exported program file when "share" is used, without
            the app holding any storage permission and without handing out a file:// URI
            (illegal since Android 7). The grant covers a single file in the cache and ends
            with the send. Saving to a file needs no provider at all - the system picker
            hands back a URI the app writes to once.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
