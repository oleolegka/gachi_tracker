<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon. Both layers are 108dp; the launcher's mask crops that to a
    72dp visible area and only the centred 66dp circle survives every mask shape.
    The drawing is framed to BLEED past the canvas so no mask ever exposes an edge,
    with the head kept inside the safe circle - see ic_launcher_foreground.xml for
    the framing numbers and why the previous icon looked small on a round launcher.

    Generated, not drawn by hand: the recipe (source grid, scale, offset) is written
    out in ic_launcher_foreground.xml. Change the numbers there and regenerate.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
